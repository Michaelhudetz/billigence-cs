# Copy to .env.local and fill in. Never commit .env.local.
# Admin connection: LOCAL scripts only (migrate, import, setup-roles). Never set this on Vercel.
# Use the Supabase *Session pooler* string: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL_ADMIN=
# Written by `bun run setup-roles`. These two (and only these) go to Vercel.
DATABASE_URL_READER=
DATABASE_URL_LOGGER=
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
